# Enforce LF line endings for all text files
* text=auto eol=lf

# TypeScript and JavaScript
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf

# Stylesheets
*.css  text eol=lf
*.scss text eol=lf

# Config and JSON files
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# HTML and Markdown
*.html text eol=lf
*.md   text eol=lf

# Lock files (keep exact formatting)
package-lock.json -text
yarn.lock -text
pnpm-lock.yaml -text